rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Le Défi de la semaine. Un document par fin de semaine, nommé par la
    // date du jeudi qui l'ouvre : defi/2026-04-16
    //
    // Ouvert sans garde, comme demandé : n'importe qui ayant l'adresse du
    // projet peut lire et écrire. Le dépôt GitHub est public, alors l'identité
    // du projet est trouvable. La date ci-dessous ferme la porte toute seule
    // le 31 décembre 2026 — sans elle, cette ouverture resterait en place
    // indéfiniment parce que personne ne s'en souviendrait.
    //
    // Pour refermer plus tôt : remplacer la ligne allow par
    //   allow read: if true;
    //   allow write: if request.resource.data.motDePasse == 'le-mot-choisi';
    // Le {document=**} est essentiel : les règles Firestore ne descendent PAS
    // toutes seules dans les sous-collections. Sans lui, defi/2026-04-16 est
    // accessible mais defi/2026-04-16/picks/Yanick ne l'est pas, et la page
    // reçoit un 403 sans explication.
    match /defi/{weekend}/{document=**} {
      allow read, write: if request.time < timestamp.date(2026, 12, 31);
    }

    // « Qui va gagner ? » — les pronostics de vainqueurs.
    // Collection SÉPARÉE de « defi » : defis/{fin de semaine}/picks/{pooleur}.
    // Une règle sur /defi ne couvre pas /defis, ce sont deux collections de
    // premier niveau sans lien entre elles. Sans ce bloc, l'onglet reçoit un
    // 403 et reste éternellement « hors ligne ».
    match /defis/{weekend}/{document=**} {
      allow read, write: if request.time < timestamp.date(2026, 12, 31);
    }

    // Tout le reste de la base demeure fermé.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
